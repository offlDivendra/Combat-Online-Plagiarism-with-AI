# Application Settings
APP_NAME="AI Plagiarism Detector"
APP_VERSION="1.0.0"
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./plagiarism_detector.db

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.pdf,.docx

# Similarity Weights (must sum to 1.0)
TFIDF_WEIGHT=0.50
NGRAM_WEIGHT=0.20
FUZZY_WEIGHT=0.30

# Classification Thresholds
THRESHOLD_LOW=20.0
THRESHOLD_MODERATE=40.0
THRESHOLD_HIGH=60.0
THRESHOLD_PLAGIARISM=80.0

# NLP Settings
MIN_SENTENCE_LENGTH=10
FUZZY_MATCH_THRESHOLD=75.0

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
